{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vpath=$1"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|workbox-.*|manifest\\.webmanifest|icon\\.svg|.*\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
