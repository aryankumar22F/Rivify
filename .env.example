# RIVIFY_API_KEY: Required on the server for Gemini-powered Math Scanner and Handwriting OCR.
# Configure RIVIFY_API_KEY in Google AI Studio Secrets (local/preview) and Vercel Environment Variables (Production).
RIVIFY_API_KEY="MY_RIVIFY_API_KEY"

# APP_URL: The public URL where this application is hosted.
# AI Studio automatically injects this at runtime with the preview URL.
# Used for self-referential links and API endpoints.
APP_URL="https://rivify-math.vercel.app"
